@model List<Post>
<div class="flex 2xl:gap-12 gap-10 mt-8 max-lg:flex-col" id="js-oversized">
        @* Reported Posts *@

        <div class="flex-1 mt-12 xl:space-y-6 space-y-3 mb-16">
                @if (Model.Count == 0){
                        <p class="font-extrabold text-3xl">No post has more than 5 reports</p>
                }
                else{
                        @foreach (var post in Model){
                                <partial name="Home/_Post"
                                         view-data='new ViewDataDictionary(ViewData) { { "ShowDetails", false }, { "AddPostSection", false } }'
                                         model="post"/>
                        }
                }

        </div>
</div>