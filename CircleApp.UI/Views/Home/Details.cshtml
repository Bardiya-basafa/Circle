@model Post

<main id="site__main" class="2xl:ml-[--w-side]  xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">

        <div class="w-full" id="js-oversized">

                <partial name="Home/_Post" model="Model"
                         view-data='new ViewDataDictionary(ViewData) { { "ShowDetails", true }, { "ShowAllComments", true }}'

                />


        </div>
</main>