@model List<Post>
@{
    ViewData["Title"] = "Home Page";
    ViewBag.Posts = Model;
    var addPost = TempData["AddPostSection"] == "true" ? true : false;
}

<main id="site__main" class="2xl:ml-[--w-side]  xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">

    <div class="lg:flex 2xl:gap-16 gap-12 max-w-[1065px] mx-auto" id="js-oversized">

        @* post and stories  *@
        <div class="max-w-[680px] mx-auto">

            @* stories *@
            @await Component.InvokeAsync("Stories")
            <div id="posts-container">
                @* add post in post section  *@
                @if (addPost){
                    <div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1">
                        <div class="flex items-center md:gap-3 gap-1">
                            <div class="flex-1 bg-slate-100 hover:bg-opacity-80 transition-all rounded-lg cursor-pointer"
                                 uk-toggle="target: #create-status">
                                <div class="py-2.5 text-center">What do you have in mind?</div>
                            </div>
                            <div class="cursor-pointer hover:bg-opacity-80 p-1 px-1.5 rounded-xl transition-all bg-pink-100/60 hover:bg-pink-100"
                                 uk-toggle="target: #create-status">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 stroke-pink-600 fill-pink-200/70"
                                     viewBox="0 0 24 24" stroke-width="1.5" stroke="#2c3e50" fill="none"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M15 8h.01"/>
                                    <path d="M12 3c7.2 0 9 1.8 9 9s-1.8 9 -9 9s-9 -1.8 -9 -9s1.8 -9 9 -9z"/>
                                    <path d="M3.5 15.5l4.5 -4.5c.928 -.893 2.072 -.893 3 0l5 5"/>
                                    <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l2.5 2.5"/>
                                </svg>
                            </div>
                        </div>

                    </div>
                }

                @* posts  *@
                @if (Model.Count == 0){
                    <div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1"
                         style="width: 580px;">
                        Currently, there are no posts available. Would you like to create the first one?
                    </div>
                }
                else{
                    @foreach (var post in Model){
                        <partial name="Home/_Post"
                                 view-data='new ViewDataDictionary(ViewData) { { "ShowDetails", true } }'
                                 model="post"/>
                    }
                }
            </div>

        </div>
        @* sidebar suggested friends  *@
        <div class="flex-1">
            <div class="lg:space-y-4 lg:pb-8 max-lg:grid sm:grid-cols-2 max-lg:gap-6">
                <div class="box p-5 px-6">
                    @await Component.InvokeAsync("Friends")
                </div>
                <div class="box p-5 px-6 border1">
                    @await Component.InvokeAsync("Hashtags")
                </div>
            </div>
        </div>

    </div>

</main>

<partial name="Modals/_CreateStory" model="new CreateStoryVm()"></partial>
<partial name="Modals/_CreateStatus" model="new PostVM()"></partial>
<partial name="Home/_DeletePostConfirmation"/>
<script>
    function openPostDeleteConfirmation(postId) {
        console.log("bardiiya")
        UIkit.dropdown('.post-options-dropdown').hide();
        console.log(postId)
        document.getElementById('deleteConfirmationPostId').value = postId;
        UIkit.modal('#postDeleteDialog').show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.body.addEventListener('click', async function (event) {
            const likeButton = event.target.closest('.like-button');
            if (!likeButton) return;

            event.preventDefault();

            likeButton.disabled = true;

            const form = likeButton.closest('form');
            const postId = form.querySelector('input[name="PostId"]').value;
            const likeContainer = document.getElementById(`like-container-${postId}`);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: new URLSearchParams(new FormData(form))
                });

                const html = await response.text();
                likeContainer.innerHTML = html;
            } finally {
                likeButton.disabled = false;
            }
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        document.body.addEventListener('click', async function (event) {
            const bookmarkButton = event.target.closest('.bookmark-button');
            if (!bookmarkButton) {
                return;
            }
            bookmarkButton.disabled = true
            event.preventDefault()
            const form = bookmarkButton.closest('form')
            const postId = form.querySelector('input[name="PostId"]').value;
            const bookmarkContainer = document.getElementById(`bookmark-container-${postId}`);
            console.log(bookmarkContainer)
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: new URLSearchParams(new FormData(form))
                })
                const html = await response.text()
                bookmarkContainer.innerHTML = html;

            } finally {
                bookmarkButton.disabled = false;
            }

            bookmarkButton.disabled = true;

        })
    })

    document.addEventListener('DOMContentLoaded', function () {
        document.body.addEventListener('click', async function (event) {
            const addCommentBtn = event.target.closest('.add-comment-button');
            console.log(addCommentBtn)
            if (!addCommentBtn) {
                return;
            }
            event.preventDefault()
            addCommentBtn.disabled = true;
            const form = addCommentBtn.closest('form')
            console.log(form)
            const postId = form.querySelector('input[name="PostId"]').value;
            console.log(postId)
            const commentContainer = document.getElementById('comment-container-' + postId);
            console.log(commentContainer)
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: new URLSearchParams(new FormData(form))
                })
                const html = await response.text()
                commentContainer.innerHTML = html;
               
            } finally {
                addCommentBtn.disabled = false
            }

        })
    })
</script>