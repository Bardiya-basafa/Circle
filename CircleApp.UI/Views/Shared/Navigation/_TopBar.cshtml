@using Infrastructure.Persistence.Constants
@{
    var username = User.Identity.Name;
    var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value;
    var action = "";

    if (User.IsInRole(AppRoles.Admin)){
        action = "asp-controller=\"Admin\" asp-action=\"Index\"";
    }
    else if (User.IsInRole(AppRoles.User)){
        action = "asp-controller=\"Home\" asp-action=\"Index\"";
    }
}
<header class="z-[100] h-[--m-top] fixed top-0 left-0 w-full flex items-center bg-white/95 backdrop-blur-xl border-b border-gray-200 shadow-sm">
    <!-- Left Section - Logo & Menu -->
    <div class="2xl:w-[--w-side] lg:w-[--w-side-sm] flex justify-center">
        <div class="flex items-center justify-center gap-3 px-4">
            <!-- Mobile Menu Button -->
            <button uk-toggle="target: #site__sidebar ; cls :!-translate-x-0"
                    class="flex items-center justify-center w-10 h-10 text-xl rounded-xl hover:bg-gray-100 xl:hidden group transition-all duration-200 hover:scale-105">
                <ion-icon name="menu-outline" class="text-2xl group-aria-expanded:hidden text-gray-700"></ion-icon>
                <ion-icon name="close-outline"
                          class="hidden text-2xl group-aria-expanded:block text-gray-700"></ion-icon>
            </button>

            <!-- Logo -->
            <div id="logo" class="flex items-center">
                <a @action
                   class="flex items-center gap-3 hover:opacity-80 transition-opacity duration-200"
                >
                    <div class="relative">
                        <img src="~/images/logo.png" class="w-10 h-10 md:block hidden rounded-lg shadow-sm"/>
                        <div class="absolute inset-0 bg-gradient-to-br from-blue-400 to-purple-500 rounded-lg opacity-0 hover:opacity-20 transition-opacity duration-200"></div>
                    </div>
                    <span class="text-xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Circle App</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Center Section - Search & Right Actions -->
    <div class="flex-1 relative">
        @if (!User.IsInRole(AppRoles.Admin)){
            <!-- Search Bar -->
            <div class="max-w-[1220px] mx-auto flex items-center px-4">
                <form asp-controller="Search" asp-action="Index" asp id="search--box"
                      class="xl:w-[680px] sm:w-96 sm:relative rounded-xl overflow-hidden z-20 bg-gray-50 hover:bg-gray-100 transition-colors duration-200 max-md:hidden w-screen left-0 max-sm:fixed max-sm:top-2 border border-gray-200 focus-within:border-blue-300 focus-within:ring-2 focus-within:ring-blue-100">

                    <ion-icon name="search" class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></ion-icon>
                    <input type="text" name="searchString" placeholder="Search Posts, Friends..."
                           class="w-full !pl-12 !pr-4 !font-normal !bg-transparent h-12 !text-sm text-gray-700 placeholder-gray-500 focus:outline-none"/>
                </form>
            </div>
        }
        <!-- Right Actions -->
        <div class="max-w-[1220px] mx-auto flex items-center">
            <div class="flex items-center sm:gap-3 gap-2 absolute right-5 top-1/2 -translate-y-1/2 text-black">

                @if (!User.IsInRole(AppRoles.Admin)){
                    <!-- Notification Button -->
                    <div class="relative">
                        <button type="button"
                                class="sm:p-3 p-2 rounded-xl relative bg-gray-50 hover:bg-gray-100 transition-all duration-200 hover:scale-105 group"
                                id="notificationBtn">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                                 class="w-6 h-6 max-sm:hidden text-gray-700 group-hover:text-blue-600 transition-colors duration-200">
                                <path d="M5.85 3.5a.75.75 0 00-1.117-1 9.719 9.719 0 00-2.348 4.876.75.75 0 001.479.248A8.219 8.219 0 015.85 3.5zM19.267 2.5a.75.75 0 10-1.118 1 8.22 8.22 0 011.987 4.124.75.75 0 001.48-.248A9.72 9.72 0 0019.266 2.5z"/>
                                <path fill-rule="evenodd"
                                      d="M12 2.25A6.75 6.75 0 005.25 9v.75a8.217 8.217 0 01-2.119 5.52.75.75 0 00.298 1.206c1.544.57 3.16.99 4.831 1.243a3.75 3.75 0 107.48 0 24.583 24.583 0 004.83-1.244.75.75 0 00.298-1.205 8.217 8.217 0 01-2.118-5.52V9A6.75 6.75 0 0012 2.25zM9.75 18c0-.034 0-.067.002-.1a25.05 25.05 0 004.496 0l.002.1a2.25 2.25 0 11-4.5 0z"
                                      clip-rule="evenodd"/>
                            </svg>
                            <!-- Notification Badge -->
                            <div class="absolute -top-1 -right-1 bg-gradient-to-r from-red-500 to-pink-500 text-white text-xs px-1.5 py-0.5 rounded-full min-w-[20px] h-5 flex items-center justify-center font-medium shadow-lg"
                                 id="notificationsCount">0
                            </div>
                        </button>

                        <!-- Notification Dropdown -->
                        <div class="hidden bg-white rounded-xl drop-shadow-2xl md:w-[380px] w-screen border border-gray-200 overflow-hidden"
                             uk-drop="offset:8;pos: bottom-right; mode: click; animate-out: true;">

                            <div class="flex items-center justify-between gap-2 p-6 pb-4 bg-gradient-to-r from-blue-50 to-purple-50 border-b border-gray-100">
                                <h3 class="font-bold text-xl text-gray-800">Notifications</h3>
                            </div>

                            <div class="text-sm h-[400px] w-full overflow-y-auto">
                                <div class="p-4 text-sm font-normal text-gray-500" id="notification-dropdown">
                                    <div class="flex flex-col items-center justify-center h-full">
                                        <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor"
                                             viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M15 17h5l-5 5-5-5h5v-12"></path>
                                        </svg>
                                        <p>No notifications yet...</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- User Profile -->
                <div class="relative">
                    <div class="rounded-full relative bg-gray-50 cursor-pointer shrink-0 p-1 hover:bg-gray-100 transition-all duration-200 hover:scale-105 group">
                        <img src="/images/avatar/user.png"
                             class="sm:w-10 sm:h-10 w-8 h-8 rounded-full shadow-md border-2 border-white group-hover:border-blue-200 transition-all duration-200"/>
                    </div>

                    <!-- User Dropdown -->
                    <div class="hidden bg-white rounded-xl drop-shadow-2xl w-72 border border-gray-200 overflow-hidden"
                         uk-drop="offset:8;pos: bottom-right;animate-out: true;">

                        <!-- User Info -->
                        <div class="p-6 py-5 flex items-center gap-4 bg-gradient-to-r from-blue-50 to-purple-50 border-b border-gray-100">
                            <div class="relative">
                                <img src="~/images/avatar/user.png"
                                     class="w-12 h-12 rounded-full shadow-md border-2 border-white"/>
                                <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-400 border-2 border-white rounded-full"></div>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-sm font-semibold text-gray-800">@fullName</h4>
                                <div class="text-sm mt-1 text-blue-600 font-medium">@username</div>
                            </div>
                        </div>

                        <!-- Menu Items -->
                        <nav class="p-2">
                            <a asp-controller="Settings" asp-action="Index" class="block">
                                <div class="flex items-center gap-3 hover:bg-gray-50 p-3 rounded-lg transition-all duration-200 group">
                                    <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors duration-200">
                                        <ion-icon name="settings-outline" class="text-lg text-blue-600"></ion-icon>
                                    </div>
                                    <span class="font-medium text-gray-700 group-hover:text-gray-900">My Account</span>
                                </div>
                            </a>

                            <div class="my-2 border-t border-gray-100"></div>

                            <a asp-controller="Authentication" asp-action="Logout" class="block">
                                <div class="flex items-center gap-3 hover:bg-red-50 p-3 rounded-lg transition-all duration-200 group">
                                    <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center group-hover:bg-red-200 transition-colors duration-200">
                                        <ion-icon name="exit-outline" class="text-lg text-red-600"></ion-icon>
                                    </div>
                                    <span class="font-medium text-gray-700 group-hover:text-red-600">Log Out</span>
                                </div>
                            </a>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<script src="https://cdnjs.cloudflare.com/ajax/libs/aspnet-signalr/1.0.27/signalr.min.js"
        referrerpolicy="no-referrer"></script>
