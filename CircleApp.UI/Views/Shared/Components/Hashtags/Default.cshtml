@model List<Hashtag>
<!-- Enhanced header for hashtags -->
<div class="flex items-center justify-between text-black mb-4">
    <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M9.243 3.03a1 1 0 01.727 1.213L9.53 6h2.94l.56-2.243a1 1 0 111.94.486L14.53 6H17a1 1 0 110 2h-2.97l-1 4H15a1 1 0 110 2h-2.47l-.56 2.242a1 1 0 11-1.94-.485L10.47 14H7.53l-.56 2.242a1 1 0 11-1.94-.485L5.47 14H3a1 1 0 110-2h2.97l1-4H5a1 1 0 110-2h2.47l.56-2.243a1 1 0 011.213-.727zM9.03 8l-1 4h2.938l1-4H9.031z" clip-rule="evenodd"/>
        </svg>
        <h3 class="font-semibold text-lg text-gray-800">Trends for you</h3>
    </div>
</div>

<!-- Enhanced hashtag list with simple boxing -->
<div class="space-y-2 capitalize text-xs font-normal mt-4 mb-2 text-gray-600 border rounded-lg overflow-hidden">
    @if (Model.Count == 0){
        <div class="flex items-center gap-3 p-4 bg-gray-50">
            <div class="flex-1">
                <h2 class="font-semibold text-gray-500 text-center">No trending hashtags</h2>
            </div>
        </div>
    }
    else{
        @foreach (var hashtag in Model){
            <a class="block hover:bg-gray-50 transition-colors duration-200 border-b last:border-b-0">
                <div class="flex items-center justify-between gap-3 p-3">
                    <div class="flex-1">
                        <h2 class="font-semibold text-blue-600">#@hashtag.Name</h2>
                        <div class="text-xs text-gray-500 mt-1">@hashtag.Count posts</div>
                    </div>
                    <div class="text-gray-400 text-xs font-medium">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </div>
                </div>
            </a>
        }
    }
</div>