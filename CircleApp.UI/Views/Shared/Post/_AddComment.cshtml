@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Post
@{
    bool isCommentsVisible = ViewData["ShowDetails"] as bool? ?? false;
}


@if (isCommentsVisible){
    <div>
        @* Comments content *@
        <div id="comment-container-@Model.PostId">
            <partial name="Post/_CommentsContent" model="Model.Comments.ToList()"/>
        </div>


        @* Show all comment section *@
        @if (Model.Comments.Count >= 3){
            <div class="p-1.5">
                <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.PostId">
                    show all comments
                </a>
            </div>
        }

        @* Comment input *@
        <form asp-controller="Home" asp-action="AddComment">

            <div class="sm:px-4 sm:py-3 p-2.5 border-t border-gray-100 flex items-center gap-1">
                <img src="~/images/avatar/user.png" class="w-6 h-6 rounded-full"/>
                <div class="flex-1 relative overflow-hidden h-10">
                    <input type="hidden" value="@Model.PostId" name="PostId"/>
                    <textarea placeholder="Add Comment...." rows="1"
                              class="w-full  resize-none !bg-transparent px-4 py-2 focus:!border-transparent focus:!ring-transparent"
                              name="Content"></textarea>
                </div>
                <button class="text-sm rounded-full py-1.5 px-3.5 bg-secondery add-comment-button">Comment
                </button>

            </div>
        </form>

    </div>
}
