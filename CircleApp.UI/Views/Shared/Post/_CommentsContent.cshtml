@using System.Security.Claims
@model List<Comment>
@{
    var loggedInUserId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
}

<div class="space-y-0">
    @foreach (var comment in Model.OrderByDescending(n => n.DateCreated)){
        <div class="flex p-3 border-l-2 border-gray-200 border-b border-gray-200 hover:border-l-2 hover:border-l-blue-300 hover:bg-gray-50 transition-all duration-200">
            <!-- Avatar -->
            <div class="mr-3">
                <a asp-controller="Users" asp-action="Details" asp-route-userId="@comment.UserId">
                    <img src="@(comment.User.ProfilePictureUrl ?? "/images/avatar/user.png")"
                         class="w-8 h-8 rounded-full object-cover border-2 border-gray-300 hover:border-blue-400 hover:scale-105 transition-all duration-200"
                         alt="@comment.User.FullName"/>
                </a>
            </div>

            <!-- Content -->
            <div class="flex-1">
                <!-- Header -->
                <div class="flex items-center justify-between mb-2">
                    <a asp-controller="Users" asp-action="Details" asp-route-userId="@comment.UserId"
                       class="font-semibold text-gray-900 hover:text-blue-600 transition-colors duration-200">
                        @comment.User.FullName
                    </a>

                    <div class="flex items-center">
                        <span class="text-xs text-gray-500 mr-2">@ViewHelper.DisplayTime(comment.DateCreated)</span>
                        @if (comment.UserId == loggedInUserId){
                            <button onclick="confirmDelete(@comment.PostId, this)"
                                    class="text-gray-400 hover:text-red-500 hover:bg-red-50 p-1 rounded transition-all duration-200">
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                        }
                    </div>
                </div>

                <!-- Comment text -->
                <div class="bg-gray-50 border-l-4 border-blue-500 rounded-r-md p-3 mb-3">
                    <p class="text-sm text-gray-800 leading-relaxed">@comment.Content</p>
                </div>

                <!-- Actions -->
                <button class="text-xs text-gray-500 hover:text-blue-600 hover:bg-blue-50 flex items-center px-2 py-1 rounded transition-all duration-200">
                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                    Like
                </button>
            </div>
        </div>
    }
</div>