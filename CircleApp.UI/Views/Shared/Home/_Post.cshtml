@model Post


@* posts section *@
<div class="md:max-w-[580px] mx-auto flex-1 xl:space-y-6 space-y-3 mb-8">


    @* loading the post of users *@


    @* Post *@
    <div id="post-@Model.PostId" class="bg-white rounded-xl shadow-xl text-sm font-medium border1">


        @* Post heading *@
        <div class="flex gap-3 sm:p-4 p-2.5 text-sm font-medium">

            @* About Author *@
            <partial name="Post/_AboutAuthor" model="Model"/>



            @* Post options  *@
            <partial name="Post/_PostOptions" model="Model"/>

        </div>

        @* post text contet  *@
        <partial name="Post/_PostTextContent" model="Model"/>

        @* post image *@
        <partial name="Post/_PostImage" model="Model"/>


        @* Icons *@
        <div class="sm:p-4 p-2.5 flex items-center gap-4 text-xs font-semibold">

            @* Like icon *@
            <div id="like-container-@Model.PostId">
                <partial name="Post/_Like" model="Model"/>
            </div>
            
           

            @* Bookmark icon  *@
            <div id="bookmark-container-@Model.PostId">
                <partial name="Post/_BookmarkIcon" model="Model"/>
            </div>
        </div>

        @* Add comment section *@
        <partial name="Post/_AddComment" model="Model"/>


    </div>

</div>

<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
